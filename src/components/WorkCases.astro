---
import { work } from '../data/content';
import Shot from './Shot.astro';
---

<section id="work" class="section light" aria-labelledby="work-heading">
  <div class="container">
    <p class="eyebrow">{work.eyebrow}</p>
    <h2 id="work-heading" class="section-heading">{work.heading}</h2>

    <ol class="cases">
      {
        work.cases.map((c, i) => (
          <li>
            <article class="case" aria-labelledby={`case-${i + 1}`}>
              <header class="case-head">
                <span class="case-num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  {c.tag && <p class="tag">{c.tag}</p>}
                  <h3 id={`case-${i + 1}`}>{c.title}</h3>
                  <p class="nutshell">
                    <span class="nutshell-label">In a nutshell:</span> {c.nutshell}
                  </p>
                </div>
                <p class="highlight">
                  <span class="highlight-value">{c.highlight.value}</span>
                  <span class="highlight-label">{c.highlight.label}</span>
                </p>
              </header>
              <dl class="case-cols">
                <div>
                  <dt>The challenge</dt>
                  <dd>{c.challenge}</dd>
                </div>
                <div>
                  <dt>{c.actionLabel}</dt>
                  <dd>{c.action}</dd>
                </div>
                <div class="results">
                  <dt>Key results</dt>
                  <dd set:html={c.results} />
                </div>
              </dl>
              {c.shots && (
                <div class="case-shots">
                  <div class:list={['shots-grid', { pair: c.shots.length > 1 }]}>
                    {c.shots.map((s) => (
                      <Shot name={s.name} alt={s.alt} />
                    ))}
                  </div>
                  {c.shotsCaption && <p class="shots-caption">{c.shotsCaption}</p>}
                </div>
              )}
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .cases {
    display: grid;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .case {
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .case-head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 1.25rem 2rem;
    padding-bottom: 1.75rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--card-border);
  }

  .case-num {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--accent-text);
    padding-top: 0.2rem;
  }

  .highlight {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 11rem;
    max-width: 14rem;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--accent);
    background: var(--body-ground);
    border-radius: 0 12px 12px 0;
  }

  .highlight-value {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    line-height: 1.05;
    color: var(--ink);
    white-space: nowrap;
  }

  .highlight-label {
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--muted);
  }

  .tag {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--accent-text);
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.2rem 0.75rem;
    margin-bottom: 0.75rem;
  }

  h3 {
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    margin-bottom: 0.75rem;
  }

  .nutshell {
    color: var(--muted);
    max-width: 70ch;
  }

  .nutshell-label {
    font-weight: 600;
    color: var(--ink);
  }

  .case-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin: 0;
  }

  dt {
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: 0.5rem;
  }

  dd {
    margin: 0;
    font-size: 1rem;
    color: var(--muted);
  }

  .results dd {
    color: var(--ink);
  }

  .results :global(strong) {
    color: var(--ink);
  }

  .case-shots {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--card-border);
  }

  .shots-grid {
    display: grid;
    gap: 1rem;
  }

  .shots-grid.pair {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .shots-caption {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .shots-grid.pair {
      grid-template-columns: 1fr;
    }

    .case-cols {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .case-head {
      grid-template-columns: auto 1fr;
    }

    .highlight {
      grid-column: 2;
      max-width: none;
    }
  }

  @media (max-width: 480px) {
    .case-head {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .highlight {
      grid-column: 1;
      margin-top: 0.75rem;
    }
  }
</style>
