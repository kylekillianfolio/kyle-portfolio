---
import { hero, site } from '../data/content';
---

<section class="hero dark" aria-labelledby="hero-heading">
  <div class="container hero-grid">
    <div class="copy">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-heading">{hero.headline}</h1>
      <p class="bio">{hero.bio}</p>
      <div class="actions">
        <a class="btn btn-primary" href="#work">See my work</a>
        <a class="btn btn-ghost" href={site.linkedin}>LinkedIn</a>
        <a class="btn btn-ghost" href={site.resume}>Résumé</a>
      </div>
      <p class="status"><span class="dot" aria-hidden="true"></span>{hero.status}</p>
    </div>

    <div class="portrait-wrap">
      <img
        class="portrait"
        src="/headshot-640.webp"
        srcset="/headshot-320.webp 320w, /headshot-640.webp 640w"
        sizes="(max-width: 860px) 112px, 320px"
        width="640"
        height="640"
        alt={`Portrait of ${site.name}`}
        fetchpriority="high"
        decoding="async"
      />
      <!-- Award seal: the guilloché rosette around real, readable text -->
      <p class="seal">
        <img class="seal-art" src="/patterns/rosette.svg" width="156" height="156" alt="" fetchpriority="low" decoding="async" />
        <span class="seal-year">Aug 2026</span>
        <span class="seal-label">AI Impact Award</span>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(4rem, 10vw, 7.5rem) clamp(3.5rem, 8vw, 6rem);
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 3.5rem;
  }

  .portrait-wrap {
    position: relative;
  }

  .portrait {
    display: block;
    width: 320px;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line-dark);
    box-shadow: 0 0 0 6px var(--band);
  }

  .seal {
    position: absolute;
    left: -40px;
    bottom: -40px;
    width: 156px;
    height: 156px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--ground);
    text-align: center;
  }

  .seal-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  /* Center disk that holds the text, above the line-work */
  .seal::before {
    content: '';
    position: absolute;
    z-index: 1;
    width: 82px;
    height: 82px;
    border-radius: 50%;
    background: var(--ground);
    border: 1px solid var(--accent);
  }

  .seal-year,
  .seal-label {
    position: relative;
    z-index: 2;
  }

  .seal-year {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--accent);
  }

  .seal-label {
    max-width: 4.5rem;
    margin-top: 0.2rem;
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.25;
    text-transform: uppercase;
    color: var(--on-dark-heading);
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    /* On phones the photo and seal sit side by side, above the eyebrow */
    .portrait-wrap {
      order: -1;
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.75rem;
    }

    .portrait {
      width: 112px;
      border-radius: var(--radius);
      box-shadow: 0 0 0 4px var(--band);
    }

    .seal {
      position: relative;
      left: auto;
      bottom: auto;
      width: 128px;
      height: 128px;
    }

    .seal::before {
      width: 76px;
      height: 76px;
    }

    .seal-year {
      font-size: 0.75rem;
    }
  }

  h1 {
    font-size: clamp(2.25rem, 6vw, 4rem);
    max-width: 20ch;
    margin-bottom: 1.5rem;
  }

  .bio {
    max-width: 62ch;
    font-size: clamp(1.0625rem, 2vw, 1.1875rem);
    margin-bottom: 2.25rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .status {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    font-size: 0.9375rem;
  }

  .dot {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    transform: translateY(-0.1em);
  }
</style>
