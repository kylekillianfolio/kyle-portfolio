---
import { contact, site } from '../data/content';
---

<section id="contact" class="section dark contact" aria-labelledby="contact-heading">
  <div class="container">
    <h2 id="contact-heading" class="section-heading">{contact.heading}</h2>
    <p class="body">{contact.body}</p>
    <div class="actions">
      <a class="btn btn-primary" href={`mailto:${site.email}`}>{site.email}</a>
      <a class="btn btn-ghost" href={site.linkedin}>linkedin.com/in/kylekillianmba</a>
    </div>
  </div>
</section>

<footer class="footer dark">
  <div class="container">
    <p>{contact.footer}</p>
  </div>
</footer>

<style>
  .body {
    max-width: 58ch;
    font-size: 1.125rem;
    margin-bottom: 2rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .actions .btn {
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .footer {
    border-top: 1px solid var(--line-dark);
    padding-block: 1.75rem;
    font-size: 0.9375rem;
  }
</style>
